# ============================================================================
# عافيتك (Aafiatak) — Environment Variables
# ============================================================================
# Copy this file to .env and fill in ALL values before starting the server.
# Never commit .env to version control.
# ============================================================================

# ── Database ──────────────────────────────────────────────────────
# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aafiatak?retryWrites=true&w=majority

# ── JWT Secrets ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED — server will refuse to start without these.
JWT_SECRET=<generate-a-strong-64-char-random-hex>
JWT_REFRESH_SECRET=<generate-a-different-64-char-random-hex>
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ── Web Push (VAPID) ──────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# REQUIRED for push notifications. Server will warn (not crash) if missing.
VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PRIVATE_KEY=<your-vapid-private-key>
VAPID_SUBJECT=mailto:support@aafiatak.com

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────
# Free tier at https://console.upstash.com — strongly recommended in production.
# Without these, rate limiting is in-memory only and won't work across
# serverless instances (Vercel functions).
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>

# ── Socket.IO Service ─────────────────────────────────────────────
# URL of the standalone Socket.IO mini-service
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ── Firebase Admin SDK (FCM Push Notifications) ──────────────────
# Required for sending push notifications to Android/iOS devices.
# Get these from Firebase Console > Project Settings > Service Accounts.
# The private key can be base64-encoded or raw PEM with \n for newlines.
FIREBASE_PROJECT_ID=aafiatak-a23fa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@aafiatak-a23fa.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=<your-firebase-private-key>
# Optional: Firebase Realtime Database URL
FIREBASE_DATABASE_URL=

# ── App ───────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
